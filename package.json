{
  "name": "pi-rich-renderer",
  "version": "0.1.0",
  "description": "Rich block viewer, copier and exporter for Pi Coding Agent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/src/extension-entrypoint.d.ts",
  "scripts": {
    "build": "esbuild src/extension-entrypoint.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@earendil-works/* && tsc --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
